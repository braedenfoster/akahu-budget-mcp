# Akahu budgeting MCP server configuration.
# Copy to .env and fill in. NEVER commit .env — it holds bank credentials.

# --- Server ---------------------------------------------------------------
# Bind to the Tailscale interface / localhost only in Phase 1 (ADR-0002).
HOST=127.0.0.1
PORT=3000

# Absolute or relative path to the sqlite cache. Kept out of git (.gitignore).
DATABASE_PATH=./data/budget.sqlite

# Lock the server to reads when set to "true" (user story 49).
READ_ONLY=false

# --- Budget model ---------------------------------------------------------
HOME_CURRENCY=NZD
# Day of month a Period begins (1..28). Default 1 (calendar month, ADR-0004).
BUDGET_MONTH_START_DAY=1

# node-cron expression for the nightly Akahu sync (ADR-0005). Default 2am.
SYNC_CRON=0 2 * * *

# --- Akahu Connections ----------------------------------------------------
# One numbered pair per Household Member's Akahu Personal App. Add _2, _3, ...
# for additional Connections (e.g. a partner). Tokens are secret and are never
# logged or returned by any tool.
AKAHU_MEMBER_NAME_1=Me
AKAHU_APP_TOKEN_1=app_token_xxx
AKAHU_USER_TOKEN_1=user_token_xxx

# AKAHU_MEMBER_NAME_2=Partner
# AKAHU_APP_TOKEN_2=app_token_yyy
# AKAHU_USER_TOKEN_2=user_token_yyy
