# Akahu budgeting MCP server configuration.
# Copy to .env and fill in. NEVER commit .env — it holds bank credentials.

# --- Server ---------------------------------------------------------------
# Bind to the Tailscale interface / localhost only in Phase 1 (ADR-0002).
HOST=127.0.0.1
PORT=3000

# Absolute or relative path to the sqlite cache. Kept out of git (.gitignore).
DATABASE_PATH=./data/budget.sqlite

# Lock the server to reads when set to "true" (user story 49).
READ_ONLY=false

# --- Budget model ---------------------------------------------------------
HOME_CURRENCY=NZD
# Day of month a Period begins (1..28). Default 1 (calendar month, ADR-0004).
BUDGET_MONTH_START_DAY=1

# node-cron expression for the nightly Akahu sync (ADR-0005). Default 2am.
SYNC_CRON=0 2 * * *

# --- Akahu Connections ----------------------------------------------------
# One numbered pair per Household Member's Akahu Personal App. Add _2, _3, ...
# for additional Connections (e.g. a partner). Tokens are secret and are never
# logged or returned by any tool.
AKAHU_MEMBER_NAME_1=Me
AKAHU_APP_TOKEN_1=app_token_xxx
AKAHU_USER_TOKEN_1=user_token_xxx

# AKAHU_MEMBER_NAME_2=Partner
# AKAHU_APP_TOKEN_2=app_token_yyy
# AKAHU_USER_TOKEN_2=user_token_yyy

# --- Phase 2: public exposure + OAuth (ADR-0010) --------------------------
# OPT-IN. Leave PUBLIC_PORT unset to run the tailnet-only V1 (Phase 1). When
# set, a second, OAuth-guarded listener binds on this port — the only port
# `tailscale funnel` should target. Stytch is the Authorization Server; this app
# only validates its JWTs. See deploy/phase2-funnel-oauth.md.
# PUBLIC_PORT=3443

# Required when PUBLIC_PORT is set (server fails fast if any are missing).
# Values below are the research-correct shape for a Stytch B2B Connected App
# (see docs/research/stytch-connected-apps-mcp.md + deploy/phase2-funnel-oauth.md):
# STYTCH_PROJECT_ID=project-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AUTH_ISSUER=https://<slug>.customers.stytch.dev      # token `iss` = project domain
# AUTH_AUDIENCE=project-test-xxxxxxxx-...              # token `aud` = the PROJECT_ID, NOT the MCP URL

# Optional (defaults derived from the above):
# AUTH_RESOURCE=https://<host>.<tailnet>.ts.net/mcp    # RFC 9728 resource id = canonical MCP URL
# STYTCH_JWKS_URL=https://<slug>.customers.stytch.dev/.well-known/jwks.json
# AUTH_EMAIL_CLAIM=email                                # set in the Stytch access-token template

# The email → Member allowlist. A valid token whose email maps to no Member is
# refused (403). Case-insensitive. Names match seeded Member names.
# AUTH_MEMBER_EMAILS=Me:me@example.com,Partner:partner@example.com

# Member the OAuth-free tailnet path is attributed to (default: first seeded).
# TAILNET_DEFAULT_MEMBER=Me
