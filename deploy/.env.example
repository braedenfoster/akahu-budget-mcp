# Deploy target for deploy/deploy.sh.
# Copy this file to deploy/.env and fill it in. deploy/.env is git-ignored.
# Anything already exported in your shell overrides these values.

# SSH target for the Pi, as user@host. Use the Tailscale IP (100.x.y.z) or the
# MagicDNS hostname. You must be on the tailnet to reach it.
PI=user@100.x.y.z

# Path to the repo on the Pi, relative to the SSH user's home directory.
PI_DIR=akahu-budget-mcp

# Public base URL (Tailscale Funnel) used for the post-deploy health checks.
PUBLIC_URL=https://your-host.tailXXXXXX.ts.net
