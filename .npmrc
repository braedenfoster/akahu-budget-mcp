# Always compile native modules (better-sqlite3) from source instead of
# fetching a prebuilt binary. On bleeding-edge Node (e.g. 26 / ABI 147),
# prebuild-install otherwise grabs a mismatched prebuilt (Node 22 / ABI 127),
# which loads with "NODE_MODULE_VERSION 127 ... requires 147". Building from
# source pins the binary to whatever Node is actually running (the Volta pin).
build-from-source=true
