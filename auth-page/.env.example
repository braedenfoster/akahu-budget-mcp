# auth-page build config. Copy to auth-page/.env and fill in before `pnpm build`.
# This token is a Stytch *public* (publishable) token — it is embedded in the
# built JS and is safe to expose. It is NOT a secret key. Still kept out of git
# so the committed source has no environment baked in.
#
# Stytch dashboard → API Keys → "public token".
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
